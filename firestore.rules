rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: check if the requesting user is an admin
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Enrolment codes: anyone can read (needed before auth during registration)
    // Authenticated users can update currentUses (needed during registration)
    match /enrolmentCodes/{codeId} {
      allow read: if true;
      allow update: if request.auth != null;
      allow create, delete: if false;
    }

    // User documents
    match /users/{userId} {
      allow create: if request.auth != null && request.auth.uid == userId;
      allow read, update: if request.auth != null && request.auth.uid == userId;

      // Admins can read any user document (for candidate management)
      allow read: if isAdmin();

      // Module progress subcollection
      match /progress/{moduleId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
        allow read, write: if isAdmin();
      }

      // Certificate records subcollection
      match /certificates/{certId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow read, write: if isAdmin();
        allow create: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Notifications log: authenticated users can create, admins can read all
    match /notifications/{notifId} {
      allow create: if request.auth != null;
      allow read: if isAdmin();
    }

    // Sessions: admins can CRUD, authenticated users can read their cohort's sessions
    match /sessions/{sessionId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }

    // Attendance: admins can CRUD, candidates can read their own records
    match /attendance/{recordId} {
      allow read: if request.auth != null
        && (resource.data.candidateUid == request.auth.uid || isAdmin());
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
  }
}
