rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Enrolment codes: anyone can read (needed before auth during registration)
    // Authenticated users can update currentUses (needed during registration)
    match /enrolmentCodes/{codeId} {
      allow read: if true;
      allow update: if request.auth != null;
      allow create, delete: if false;
    }

    // User documents
    match /users/{userId} {
      // Users can read and create their own document
      allow create: if request.auth != null && request.auth.uid == userId;
      allow read, update: if request.auth != null && request.auth.uid == userId;

      // Module progress subcollection
      match /progress/{moduleId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
